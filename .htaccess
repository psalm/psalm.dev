Header set Access-Control-Allow-Origin "*"

<IfModule mod_mime.c>
    AddType application/javascript          js
    AddType application/x-font-woff         woff
    AddType application/x-font-woff2        woff2
    AddType image/svg+xml                   svg svgz 
    AddType text/markdown                   md
    AddCharset utf-8                        .md
    AddEncoding gzip                        svgz
</Ifmodule>

<IfModule mod_deflate.c>
  # Compress HTML, CSS, JavaScript, Text, XML and fonts
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
  AddOutputFilterByType DEFLATE application/x-font
  AddOutputFilterByType DEFLATE application/x-font-opentype
  AddOutputFilterByType DEFLATE application/x-font-otf
  AddOutputFilterByType DEFLATE application/x-font-truetype
  AddOutputFilterByType DEFLATE application/x-font-ttf
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/x-font-woff
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE image/x-icon
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE text/markdown
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
</IfModule>

# Without explicit headers browsers guess a cache lifetime from the file age
# and can keep stale copies for weeks. Stylesheets and scripts are linked with
# a ?v=<file mtime> version (includes/asset.php, or ?v=N in mkdocs.yml), so a
# versioned URL never changes and is cached for good; unversioned requests get
# a short lifetime.
# mkdocs-material's hashed assets never change either.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600"
    <If "%{QUERY_STRING} =~ /^(v=)?[0-9]+$/">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
  </FilesMatch>
  <FilesMatch "\.[0-9a-f]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # The web fonts in /extra/ have not changed in years
  <FilesMatch "\.(woff2?)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "\.md$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # Docs page URLs answer with HTML or Markdown depending on Accept (see the rewrites below)
  <If "%{THE_REQUEST} =~ m#^\S+ /docs/#">
    Header merge Vary Accept
  </If>
  <FilesMatch "\.(png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>

DirectoryIndex index.php index.html

# Old docs URLs (through fixing_code below), with or without a trailing slash or index.html.
# Targets end with a slash, as mkdocs serves them, so each is a single hop
RedirectMatch 301 ^/docs/installation(/|/index\.html)?$ https://psalm.dev/docs/running_psalm/installation/
RedirectMatch 301 ^/docs/configuration(/|/index\.html)?$ https://psalm.dev/docs/running_psalm/configuration/
RedirectMatch 301 ^/docs/using_plugins(/|/index\.html)?$ https://psalm.dev/docs/running_psalm/plugins/using_plugins/
RedirectMatch 301 ^/docs/authoring_plugins(/|/index\.html)?$ https://psalm.dev/docs/running_psalm/plugins/authoring_plugins/
RedirectMatch 301 ^/docs/plugins_type_system(/|/index\.html)?$ https://psalm.dev/docs/running_psalm/plugins/plugins_type_system/
RedirectMatch 301 ^/docs/language_server(/|/index\.html)?$ https://psalm.dev/docs/running_psalm/language_server/
RedirectMatch 301 ^/docs/typing_in_psalm(/|/index\.html)?$ https://psalm.dev/docs/annotating_code/typing_in_psalm/
RedirectMatch 301 ^/docs/templated_annotations(/|/index\.html)?$ https://psalm.dev/docs/annotating_code/templated_annotations/
RedirectMatch 301 ^/docs/supported_annotations(/|/index\.html)?$ https://psalm.dev/docs/annotating_code/supported_annotations/
RedirectMatch 301 ^/docs/annotating_code/docblock_type_syntax(/|/index\.html)?$ https://psalm.dev/docs/annotating_code/typing_in_psalm/

RedirectMatch 301 ^/docs/fixing_code(/|/index\.html)?$ https://psalm.dev/docs/manipulating_code/fixing/

Redirect 307 /v2/ https://registry.hub.docker.com/v2/

RewriteEngine On
RewriteBase /
RewriteRule ^articles/([a-z0-9\-]+)/?$ /views/article.php?name=$1 [L,NC]
RewriteRule ^articles/?$ /views/articles/index.php [L,NC]
RewriteRule ^articles/auth/save/?$ /views/articles/auth_save.php [L,NC]
RewriteRule ^articles/auth/init/?$ /views/articles/auth_init.php [L,NC]
RewriteRule ^r/([a-z0-9]+)/(\w+)$ /views/snippet.php?r=$1&format=$2 [L,NC,QSA]
RewriteRule ^r/([a-z0-9]+)\.json$ /views/snippet.php?r=$1&format=json [L,NC]
RewriteRule ^r/([a-z0-9]+)$ /views/snippet.php?r=$1 [L,NC]
RewriteRule ^check$ /views/check.php [L,NC]
RewriteRule ^sitemap\.xml$ /views/sitemap.php [L,NC]
RewriteRule ^add_code$ /views/add_code.php [L,NC]
RewriteRule ^play/?$ /views/index.php?page=play [L,NC,QSA]
RewriteRule ^(playground|r|demo|try|sandbox)/?$ /play [R=301,L,NC,QSA]
RewriteRule ^migrate$ /views/migrate.php [L,NC,QSA]
RewriteRule ^quickstart/?$ https://psalm.dev/docs/running_psalm/installation/ [R=301,L]
RewriteRule ^contribute/?$ /views/contribute.php [L,NC]
RewriteRule ^support/?$ /views/support.php [L,NC]
RewriteRule ^plugins/?$ /views/plugins.php [L,NC]
RewriteRule ^$ /views/index.php [L,NC]
RewriteRule ^schema/config$ /vendor/vimeo/psalm/config.xsd [L,NC]
# Docs pages as Markdown (/docs/<path>.md), served from vendor/vimeo/psalm/docs, the mkdocs source.
# Clients sending "Accept: text/markdown" get the same file at the page URL itself, so links
# from Psalm output (psalm.dev/123 -> /docs/running_psalm/issues/<Type>/) work as Markdown too.
# mkdocs builds a directory page from <dir>/index.md or <dir>/README.md.
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteCond %{DOCUMENT_ROOT}/vendor/vimeo/psalm/docs/$1.md -f
RewriteRule ^docs/((?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+)/(?:index\.html)?$ /vendor/vimeo/psalm/docs/$1.md [L]
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteCond %{DOCUMENT_ROOT}/vendor/vimeo/psalm/docs/$1index.md -f
RewriteRule ^docs/((?:[A-Za-z0-9_-]+/)*)(?:index\.html)?$ /vendor/vimeo/psalm/docs/$1index.md [L]
RewriteCond %{HTTP_ACCEPT} text/markdown [NC]
RewriteCond %{DOCUMENT_ROOT}/vendor/vimeo/psalm/docs/$1README.md -f
RewriteRule ^docs/((?:[A-Za-z0-9_-]+/)*)(?:index\.html)?$ /vendor/vimeo/psalm/docs/$1README.md [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^docs/((?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.md)$ /vendor/vimeo/psalm/docs/$1 [L]
RewriteRule ^llms\.txt$ /views/llms.php [L]
RewriteRule ^[0-9]{3}\)?$ /views/issue_redirect.php [L,NC]
# Issue type shortcuts: /InvalidArgument -> its docs page, only when that page exists (#29)
RewriteCond %{DOCUMENT_ROOT}/docs/running_psalm/issues/$1/index.html -f
RewriteRule ^([A-Z][A-Za-z]+)/?$ https://psalm.dev/docs/running_psalm/issues/$1/ [R=301,L]


# Repository files that are not part of the site. PHP files outside views/ must not run on their own
RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|(webpack|postcss)\.config\.js|mkdocs\.yml|psalm\.xml|phinx\.php|blogconfig\.php|dbconfig(\.dist)?\.php|codes\.sql|Dockerfile|docker-compose\.yaml)$ - [F,L,NC]
RewriteRule ^(src|theme|docker|vendor-bin|node_modules)(/|$) - [F,L,NC]
RewriteRule ^includes/?.*$ - [F,L]
RewriteCond %{REQUEST_URI} !^/vendor/vimeo/psalm/(config\.xsd|docs/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\.md)$
RewriteRule ^vendor/?.*$ - [F,L]
RewriteRule ^.git/?.*$ - [F,L]
RewriteRule ^dbconfig.php.*$ - [F,L]
RewriteRule ^bin/?.*$ - [F,L]
RewriteRule ^db/?.*$ - [F,L]
RewriteRule ^\.venv-docs/?.*$ - [F,L]

